rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // USERS
    // =========================================================
    match /users/{userId} {

      allow read: if request.auth != null;

      allow write: if request.auth != null
                    && request.auth.uid == userId;


      // =======================================================
      // FRIENDS
      // =======================================================
      match /friends/{friendId} {

        allow read: if request.auth != null
                     && request.auth.uid == userId;

        allow write: if request.auth != null
                     && (
                       request.auth.uid == userId ||
                       request.auth.uid == friendId
                     );
      }


      // =======================================================
      // WASTE LOGS
      // =======================================================
      match /wasteLogs/{logId} {

        allow read: if request.auth != null
                    && request.auth.uid == userId;

        allow create: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.iso is string
                      && request.resource.data.type is string
                      && request.resource.data.foodWaste is number
                      && request.resource.data.foodWaste >= 0
                      && request.resource.data.plastic is number
                      && request.resource.data.plastic >= 0
                      && request.resource.data.water is number
                      && request.resource.data.water >= 0
                      && request.resource.data.disposables is number
                      && request.resource.data.disposables >= 0;

        allow update: if request.auth != null
                      && request.auth.uid == userId
                      && request.resource.data.foodWaste is number
                      && request.resource.data.foodWaste >= 0
                      && request.resource.data.plastic is number
                      && request.resource.data.plastic >= 0
                      && request.resource.data.water is number
                      && request.resource.data.water >= 0
                      && request.resource.data.disposables is number
                      && request.resource.data.disposables >= 0;

        allow delete: if request.auth != null
                      && request.auth.uid == userId;
      }


      // =======================================================
      // TRAVEL HISTORY
      // =======================================================
      match /travelHistory/{tripId} {

        allow read, create, update, delete:
          if request.auth != null
          && request.auth.uid == userId;


        // =====================================================
        // ECO REPORT
        // =====================================================
        match /ecoReport/{reportId} {

          function finishLockPath() {
            return /databases/$(database)/documents/activeTripLocks/$(request.auth.uid);
          }

          function finishSessionPath(sessionId) {
            return /databases/$(database)/documents/tripSessions/$(sessionId);
          }

          function finishItineraryPath(itineraryId) {
            return /databases/$(database)/documents/itineraries/$(itineraryId);
          }

          function isReportScore(value) {
            return (value is int || value is float) && value >= 0 && value <= 100;
          }

          function isOptionalDate(value) {
            return value == null || value is timestamp || value is string;
          }

          function ecoReportWriteKeys() {
            return [
              "userId",
              "itineraryId",
              "tripId",
              "sessionId",
              "tripName",
              "originName",
              "destinationNames",
              "startDate",
              "endDate",
              "location",
              "planEcoScore",
              "transportationEcoScore",
              "finalEcoScore",
              "ecoScore",
              "scoreCompleteness",
              "scoreFormulaVersion",
              "confirmedTransportationCarbonKg",
              "carbonScope",
              "carbonVersion",
              "segments",
              "status",
              "visibility",
              "publishedAt",
              "source",
              "version",
              "createdAt",
              "updatedAt",
              "completedAt"
            ];
          }

          function validFinishReportPayload(tripId) {
            let data = request.resource.data;
            let lockPath = finishLockPath();
            let sessionId = data.sessionId;
            let sessionPath = finishSessionPath(sessionId);
            let itineraryPath = finishItineraryPath(tripId);

            return request.auth != null
                   && request.auth.uid == userId
                   && reportId == "report"
                   && data.keys().hasAll(ecoReportWriteKeys())
                   && data.keys().hasOnly(ecoReportWriteKeys())
                   && data.userId == request.auth.uid
                   && data.itineraryId == tripId
                   && data.tripId == tripId
                   && data.sessionId is string
                   && data.sessionId.size() > 0
                   && data.tripName is string
                   && data.originName is string
                   && data.destinationNames is list
                   && isOptionalDate(data.startDate)
                   && isOptionalDate(data.endDate)
                   && data.location is string
                   && (data.planEcoScore == null || isReportScore(data.planEcoScore))
                   && isReportScore(data.transportationEcoScore)
                   && isReportScore(data.finalEcoScore)
                   && data.ecoScore == data.finalEcoScore
                   && data.scoreCompleteness in ["plan_and_transport", "transport_only"]
                   && data.scoreFormulaVersion == "plan-transport-mean-v1"
                   && (data.confirmedTransportationCarbonKg is int || data.confirmedTransportationCarbonKg is float)
                   && data.confirmedTransportationCarbonKg >= 0
                   && data.carbonScope == "completed_segments_only"
                   && data.carbonVersion == "prototype-uk-ghg-2026-v1"
                   && data.segments is list
                   && data.status == "Completed"
                   && data.visibility == "private"
                   && data.publishedAt == null
                   && data.source == "module2_finish_trip"
                   && data.version == 1
                   && data.createdAt == request.time
                   && data.updatedAt == request.time
                   && data.completedAt == request.time
                   && exists(lockPath)
                   && get(lockPath).data.userId == request.auth.uid
                   && get(lockPath).data.sessionId == sessionId
                   && get(lockPath).data.itineraryId == tripId
                   && !existsAfter(lockPath)
                   && existsAfter(sessionPath)
                   && getAfter(sessionPath).data.status == "completed"
                   && getAfter(sessionPath).data.userId == request.auth.uid
                   && getAfter(sessionPath).data.itineraryId == tripId
                   && existsAfter(itineraryPath)
                   && getAfter(itineraryPath).data.module2Complete == true
                   && getAfter(itineraryPath).data.status == "Completed";
          }

          function isLegacyReportStub() {
            return !(resource.data.keys().hasAll(["source"])
                     && resource.data.source == "module2_finish_trip");
          }

          function validEcoReportPublish() {
            let before = resource.data;
            let after = request.resource.data;

            return request.auth != null
                   && request.auth.uid == userId
                   && before.userId == request.auth.uid
                   && before.source == "module2_finish_trip"
                   && after.userId == before.userId
                   && after.sessionId == before.sessionId
                   && after.itineraryId == before.itineraryId
                   && after.finalEcoScore == before.finalEcoScore
                   && after.ecoScore == before.ecoScore
                   && after.planEcoScore == before.planEcoScore
                   && after.transportationEcoScore == before.transportationEcoScore
                   && after.confirmedTransportationCarbonKg == before.confirmedTransportationCarbonKg
                   && after.segments == before.segments
                   && after.completedAt == before.completedAt
                   && after.tripName == before.tripName
                   && after.source == before.source
                   && after.visibility == "public"
                   && after.publishedAt == request.time
                   && after.updatedAt == request.time
                   && after.diff(before).affectedKeys().hasOnly([
                        "visibility",
                        "publishedAt",
                        "updatedAt"
                      ]);
          }

          allow read: if request.auth != null
                      && (
                        request.auth.uid == userId ||
                        (
                          resource.data.visibility == "public"
                          && resource.data.source == "module2_finish_trip"
                        )
                      );

          allow create: if validFinishReportPayload(tripId);

          allow update: if (isLegacyReportStub() && validFinishReportPayload(tripId))
                        || validEcoReportPublish();

          allow delete: if false;
        }
      }


      // =======================================================
      // USER ACHIEVEMENTS
      // =======================================================
      match /achievements/{achievementId} {

        allow read:
          if request.auth != null
          && request.auth.uid == userId;

        allow create, update, delete:
          if request.auth != null
          && request.auth.uid == userId;
      }
    }


    // =========================================================
    // FRIEND REQUESTS
    // =========================================================
    match /friendRequests/{requestId} {

      allow read: if request.auth != null
        && (
          request.auth.uid == resource.data.fromUid ||
          request.auth.uid == resource.data.toUid
        );

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.fromUid;

      allow update: if request.auth != null
        && request.auth.uid == resource.data.toUid;

      allow delete: if request.auth != null
        && (
          request.auth.uid == resource.data.fromUid ||
          request.auth.uid == resource.data.toUid
        );
    }


    // =========================================================
    // CHATS / GROUPS
    // =========================================================
    match /chats/{chatId} {


      // =======================================================
      // READ CHAT
      // =======================================================
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.members;


      // =======================================================
      // CREATE CHAT / GROUP
      // =======================================================
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.createdBy
                    && request.auth.uid in request.resource.data.members;


      // =======================================================
      // UPDATE CHAT
      // =======================================================
      //
      // Normal members can update:
      // - lastMessage
      // - lastMessageAt
      // - lastMessageHiddenFor
      // - unreadCounts
      // - mutedBy
      // - pinnedBy
      //
      // Creator/admin can additionally manage:
      // - name
      // - members
      // - memberNames
      // - memberPhotos
      // - admins
      //
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.members
                    && (

                      // -------------------------------------------------
                      // NORMAL CHAT ACTIVITY
                      // -------------------------------------------------
                      request.resource.data
                        .diff(resource.data)
                        .affectedKeys()
                        .hasOnly([
                          "lastMessage",
                          "lastMessageAt",
                          "lastMessageHiddenFor",
                          "unreadCounts",
                          "mutedBy",
                          "pinnedBy"
                        ])

                      ||

                      // -------------------------------------------------
                      // CREATOR
                      // -------------------------------------------------
                      request.auth.uid == resource.data.createdBy

                      ||

                      // -------------------------------------------------
                      // GROUP ADMIN
                      // -------------------------------------------------
                      (
                        resource.data.keys().hasAll(["admins"])
                        && request.auth.uid in resource.data.admins
                        && request.resource.data
                          .diff(resource.data)
                          .affectedKeys()
                          .hasOnly([
                            "name",
                            "members",
                            "memberNames",
                            "memberPhotos",
                            "admins",
                            "unreadCounts",
                            "pinnedBy"
                          ])
                      )
                    );


      // =======================================================
      // DELETE CHAT
      // =======================================================
      //
      // Only the creator can permanently delete the chat.
      //
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.createdBy;


      // =======================================================
      // MESSAGES
      // =======================================================
      match /messages/{messageId} {


        // -----------------------------------------------------
        // READ MESSAGES
        // -----------------------------------------------------
        allow read: if request.auth != null
          && request.auth.uid in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.members;


        // -----------------------------------------------------
        // CREATE MESSAGE
        // -----------------------------------------------------
        allow create: if request.auth != null
          && request.auth.uid in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.members
          && request.auth.uid == request.resource.data.senderId;


        // -----------------------------------------------------
        // UPDATE MESSAGE
        // -----------------------------------------------------
        //
        // Three allowed update types:
        //
        // 1. Delete for me
        // 2. Mark message as seen
        // 3. Delete for everyone
        //
        allow update: if request.auth != null
          && request.auth.uid in
             get(
               /databases/$(database)/documents/chats/$(chatId)
             ).data.members
          && (

            // -------------------------------------------------
            // DELETE FOR ME
            // -------------------------------------------------
            //
            // User can add their own UID to deletedFor.
            //
            (
              request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "deletedFor"
                ])
              &&
              request.auth.uid in
                request.resource.data.deletedFor
            )


            ||


            // -------------------------------------------------
            // MARK AS SEEN
            // -------------------------------------------------
            //
            // User can add their own UID to readBy.
            //
            (
              request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "readBy"
                ])
              &&
              request.auth.uid in
                request.resource.data.readBy
            )


            ||


            // -------------------------------------------------
            // DELETE FOR EVERYONE
            // -------------------------------------------------
            //
            // Only the original sender can do this.
            //
            // The original content is replaced with a
            // deleted-message tombstone.
            //
            (
              request.auth.uid ==
                resource.data.senderId

              &&

              request.resource.data
                .deletedForEveryone == true

              &&

              request.resource.data.type ==
                "deleted"

              &&

              request.resource.data.text ==
                "This message was deleted for everyone"

              &&

              request.resource.data
                .diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  "deletedForEveryone",
                  "type",
                  "text",
                  "imageUrl",
                  "videoUrl",
                  "audioUrl",
                  "mediaUrl"
                ])
            )
          );


        // -----------------------------------------------------
        // DELETE MESSAGE DOCUMENT
        // -----------------------------------------------------
        //
        // IMPORTANT:
        // We don't physically delete message documents.
        //
        // Delete-for-everyone uses a tombstone so everyone
        // can still see:
        //
        // "This message was deleted for everyone"
        //
        allow delete: if false;
      }
    }


    // =========================================================
    // ACHIEVEMENTS
    // =========================================================
    match /achievements/{achievementId} {

      // Everyone logged in can see published achievements.
      allow read: if request.auth != null;

      // Only admins can create/update/delete achievements.
      allow write: if request.auth != null
                   && get(
                     /databases/$(database)/documents/users/$(request.auth.uid)
                   ).data.role == "admin";
    }


    // =========================================================
    // CHALLENGES
    // =========================================================
    match /challenges/{challengeId} {

      // Logged-in users can view challenges.
      allow read: if request.auth != null;

      // Only admins can manage challenges.
      allow write: if request.auth != null
                   && get(
                     /databases/$(database)/documents/users/$(request.auth.uid)
                   ).data.role == "admin";
    }


    // =========================================================
    // ITINERARIES
    // =========================================================
    //
    // Sustainable Itinerary Planning — one document per saved trip in the
    // top-level `itineraries` collection: itineraries/{itineraryId}.
    //
    // Ownership is the `userId` field, stamped with the creator's Firebase
    // Auth UID by saveItinerary() in
    // client/src/firebase/itineraryService.js.
    //
    // Module 1 (the Create wizard) creates the document; Module 2 (the
    // recommendation step) later updates it with transport + sustainability
    // values. Both run as the signed-in owner.
    //
    // Reads used by the feature:
    //   - getItinerary(id)      -> get itineraries/{id}
    //   - getMyItineraries()    -> list itineraries where userId == uid
    // Writes used by the feature:
    //   - saveItinerary()       -> create itineraries/{id}
    //   - (Module 2)            -> update itineraries/{id}
    //
    match /itineraries/{itineraryId} {

      function ownerLockPath() {
        return /databases/$(database)/documents/activeTripLocks/$(request.auth.uid);
      }

      function thisItineraryLocked() {
        return request.auth != null
               && exists(ownerLockPath())
               && get(ownerLockPath()).data.userId == request.auth.uid
               && get(ownerLockPath()).data.itineraryId == itineraryId;
      }

      function validItineraryFinishUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let lockPath = ownerLockPath();
        let sessionId = get(lockPath).data.sessionId;
        let sessionPath = /databases/$(database)/documents/tripSessions/$(sessionId);
        let reportPath = /databases/$(database)/documents/users/$(request.auth.uid)/travelHistory/$(itineraryId)/ecoReport/report;

        return request.auth != null
               && before.userId == request.auth.uid
               && after.userId == before.userId
               && thisItineraryLocked()
               && after.diff(before).affectedKeys().hasOnly([
                    "module2Complete",
                    "status",
                    "isCompleted",
                    "completedAt",
                    "updatedAt"
                  ])
               && after.module2Complete == true
               && after.status == "Completed"
               && after.isCompleted == true
               && after.completedAt == request.time
               && after.updatedAt == request.time
               && !existsAfter(lockPath)
               && existsAfter(sessionPath)
               && getAfter(sessionPath).data.status == "completed"
               && getAfter(sessionPath).data.itineraryId == itineraryId
               && existsAfter(reportPath)
               && getAfter(reportPath).data.source == "module2_finish_trip"
               && getAfter(reportPath).data.sessionId == sessionId
               && getAfter(reportPath).data.visibility == "private";
      }

      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;

      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && (
                      !thisItineraryLocked() ||
                      validItineraryFinishUpdate()
                    );

      allow delete: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && !thisItineraryLocked();
    }


    // =========================================================
    // TRIP SESSIONS  (Module 2)
    // =========================================================
    //
    // tripSessions/{sessionId} is Module 2 activation history.
    // Module 1 itineraries stay in the existing `itineraries` collection.
    // Start, cancel, and finish must be atomic with activeTripLocks/{uid}.
    // Segment completion cannot mark the session completed.
    //
    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    function itineraryPath(itineraryId) {
      return /databases/$(database)/documents/itineraries/$(itineraryId);
    }

    function tripSessionPath(sessionId) {
      return /databases/$(database)/documents/tripSessions/$(sessionId);
    }

    function activeLockPath(uid) {
      return /databases/$(database)/documents/activeTripLocks/$(uid);
    }

    function ecoReportPath(uid, itineraryId) {
      return /databases/$(database)/documents/users/$(uid)/travelHistory/$(itineraryId)/ecoReport/report;
    }

    function ownedCompleteItinerary(itineraryId) {
      return isNonEmptyString(itineraryId)
             && exists(itineraryPath(itineraryId))
             && get(itineraryPath(itineraryId)).data.userId == request.auth.uid
             && get(itineraryPath(itineraryId)).data.module1Complete == true;
    }

    function tripSessionCreateKeys() {
      return [
        "userId",
        "itineraryId",
        "itineraryTitle",
        "status",
        "currentSegmentIndex",
        "totalSegments",
        "startedAt",
        "updatedAt",
        "completedAt",
        "cancelledAt",
        "cancellationReason",
        "version"
      ];
    }

    function validTripSessionCreate(sessionId) {
      let data = request.resource.data;
      let lockPath = activeLockPath(request.auth.uid);

      return isSignedIn()
             && data.keys().hasAll(tripSessionCreateKeys())
             && data.keys().hasOnly(tripSessionCreateKeys())
             && data.userId is string
             && data.userId == request.auth.uid
             && isNonEmptyString(data.itineraryId)
             && data.itineraryTitle is string
             && data.status == "active"
             && data.currentSegmentIndex is int
             && data.currentSegmentIndex == 0
             && data.totalSegments is int
             && data.totalSegments > 0
             && data.startedAt == request.time
             && data.updatedAt == request.time
             && data.completedAt == null
             && data.cancelledAt == null
             && data.cancellationReason == null
             && data.version is int
             && data.version == 1
             && ownedCompleteItinerary(data.itineraryId)
             && existsAfter(lockPath)
             && getAfter(lockPath).data.userId == request.auth.uid
             && getAfter(lockPath).data.sessionId == sessionId
             && getAfter(lockPath).data.itineraryId == data.itineraryId
             && getAfter(lockPath).data.status == "active";
    }

    function validTripSessionCancel() {
      let before = resource.data;
      let after = request.resource.data;
      let lockPath = activeLockPath(request.auth.uid);

      return isSignedIn()
             && before.userId == request.auth.uid
             && after.userId == before.userId
             && after.itineraryId == before.itineraryId
             && before.status == "active"
             && after.status == "cancelled"
             && after.completedAt == null
             && after.cancelledAt == request.time
             && after.updatedAt == request.time
             && after.cancellationReason == "user_cancelled"
             && after.diff(before).affectedKeys().hasOnly([
                  "status",
                  "cancelledAt",
                  "updatedAt",
                  "cancellationReason"
                ])
             && !existsAfter(lockPath);
    }

    function completedSegmentPath(sessionId, segmentId) {
      return /databases/$(database)/documents/tripSessions/$(sessionId)/completedSegments/$(segmentId);
    }

    function completedSegmentCreateKeys() {
      return [
        "userId",
        "itineraryId",
        "sessionId",
        "segmentId",
        "segmentIndex",
        "originName",
        "destinationName",
        "travelMode",
        "distanceMeters",
        "durationSeconds",
        "carbonKgCo2e",
        "prototypeEcoScore",
        "rankingScore",
        "source",
        "carbonVersion",
        "completedAt",
        "version"
      ];
    }

    function isPositiveNumber(value) {
      return (value is int || value is float) && value > 0;
    }

    function isNonNegativeNumber(value) {
      return (value is int || value is float) && value >= 0;
    }

    function isScore(value) {
      return (value is int || value is float) && value >= 0 && value <= 100;
    }

    function isScoreOrNull(value) {
      return value == null || isScore(value);
    }

    function ownedTripSession(sessionId) {
      return isSignedIn()
             && exists(tripSessionPath(sessionId))
             && get(tripSessionPath(sessionId)).data.userId == request.auth.uid;
    }

    function validTripSessionProgress(sessionId) {
      let before = resource.data;
      let after = request.resource.data;
      let lockPath = activeLockPath(request.auth.uid);
      let completedId = after.latestCompletedSegmentId;
      let completedPath = completedSegmentPath(sessionId, completedId);

      return isSignedIn()
             && before.userId == request.auth.uid
             && after.userId == before.userId
             && after.itineraryId == before.itineraryId
             && after.itineraryTitle == before.itineraryTitle
             && before.status == "active"
             && after.status == "active"
             && after.completedAt == null
             && after.cancelledAt == before.cancelledAt
             && after.cancellationReason == before.cancellationReason
             && after.version == before.version
             && after.totalSegments == before.totalSegments
             && after.startedAt == before.startedAt
             && after.updatedAt == request.time
             && after.currentSegmentIndex is int
             && before.currentSegmentIndex is int
             && after.currentSegmentIndex == before.currentSegmentIndex + 1
             && after.currentSegmentIndex <= before.totalSegments
             && isNonEmptyString(completedId)
             && completedId == "segment-" + string(before.currentSegmentIndex)
             && after.diff(before).affectedKeys().hasOnly([
                  "currentSegmentIndex",
                  "updatedAt",
                  "latestCompletedSegmentId"
                ])
             && exists(lockPath)
             && get(lockPath).data.userId == request.auth.uid
             && get(lockPath).data.sessionId == sessionId
             && get(lockPath).data.status == "active"
             && existsAfter(lockPath)
             && getAfter(lockPath).data.sessionId == sessionId
             && getAfter(lockPath).data.status == "active"
             && existsAfter(completedPath)
             && getAfter(completedPath).data.userId == request.auth.uid
             && getAfter(completedPath).data.sessionId == sessionId
             && getAfter(completedPath).data.itineraryId == before.itineraryId
             && getAfter(completedPath).data.segmentIndex == before.currentSegmentIndex
             && getAfter(completedPath).data.segmentId == completedId;
    }

    function validCompletedSegmentCreate(sessionId, segmentId) {
      let data = request.resource.data;
      let sessionPath = tripSessionPath(sessionId);

      return isSignedIn()
             && exists(sessionPath)
             && get(sessionPath).data.userId == request.auth.uid
             && get(sessionPath).data.status == "active"
             && data.keys().hasAll(completedSegmentCreateKeys())
             && data.keys().hasOnly(completedSegmentCreateKeys())
             && data.userId is string
             && data.userId == request.auth.uid
             && data.sessionId == sessionId
             && data.itineraryId == get(sessionPath).data.itineraryId
             && data.segmentId == segmentId
             && data.segmentIndex is int
             && data.segmentIndex == get(sessionPath).data.currentSegmentIndex
             && segmentId == "segment-" + string(data.segmentIndex)
             && isNonEmptyString(data.originName)
             && isNonEmptyString(data.destinationName)
             && data.travelMode in ["WALK", "TRANSIT", "DRIVE"]
             && isPositiveNumber(data.distanceMeters)
             && isPositiveNumber(data.durationSeconds)
             && isNonNegativeNumber(data.carbonKgCo2e)
             && isScore(data.prototypeEcoScore)
             && isScoreOrNull(data.rankingScore)
             && data.source == "google_routes"
             && data.carbonVersion == "prototype-uk-ghg-2026-v1"
             && data.completedAt == request.time
             && data.version is int
             && data.version == 1
             && existsAfter(sessionPath)
             && getAfter(sessionPath).data.userId == request.auth.uid
             && getAfter(sessionPath).data.status == "active"
             && getAfter(sessionPath).data.currentSegmentIndex == data.segmentIndex + 1
             && getAfter(sessionPath).data.latestCompletedSegmentId == segmentId
             && getAfter(sessionPath).data.itineraryId == data.itineraryId
             && getAfter(sessionPath).data.completedAt == null;
    }

    function lockCreateKeys() {
      return [
        "userId",
        "sessionId",
        "itineraryId",
        "itineraryTitle",
        "status",
        "startedAt",
        "updatedAt"
      ];
    }

    function validActiveLockCreate(lockUserId) {
      let data = request.resource.data;

      return isSignedIn()
             && request.auth.uid == lockUserId
             && data.keys().hasAll(lockCreateKeys())
             && data.keys().hasOnly(lockCreateKeys())
             && data.userId is string
             && data.userId == request.auth.uid
             && isNonEmptyString(data.sessionId)
             && isNonEmptyString(data.itineraryId)
             && data.itineraryTitle is string
             && data.status == "active"
             && data.startedAt == request.time
             && data.updatedAt == request.time
             && existsAfter(tripSessionPath(data.sessionId))
             && getAfter(tripSessionPath(data.sessionId)).data.userId == request.auth.uid
             && getAfter(tripSessionPath(data.sessionId)).data.itineraryId == data.itineraryId
             && getAfter(tripSessionPath(data.sessionId)).data.status == "active";
    }

    // Finish cannot enumerate completedSegments/segment-0..n-1 here:
    // Firestore rules have no loop over a dynamic totalSegments count.
    // Sequential progress pairing plus currentSegmentIndex == totalSegments
    // is the rule-side guarantee; the client transaction still reads every
    // expected completion document before writing.
    function validTripSessionComplete(sessionId) {
      let before = resource.data;
      let after = request.resource.data;
      let lockPath = activeLockPath(request.auth.uid);
      let itineraryId = before.itineraryId;
      let reportPath = ecoReportPath(request.auth.uid, itineraryId);

      return isSignedIn()
             && before.userId == request.auth.uid
             && after.userId == before.userId
             && after.itineraryId == before.itineraryId
             && after.itineraryTitle == before.itineraryTitle
             && before.status == "active"
             && after.status == "completed"
             && after.currentSegmentIndex == before.totalSegments
             && after.totalSegments == before.totalSegments
             && after.totalSegments > 0
             && after.startedAt == before.startedAt
             && after.version == before.version
             && after.cancelledAt == before.cancelledAt
             && after.cancellationReason == before.cancellationReason
             && after.completedAt == request.time
             && after.updatedAt == request.time
             && after.diff(before).affectedKeys().hasOnly([
                  "status",
                  "completedAt",
                  "updatedAt"
                ])
             && exists(lockPath)
             && get(lockPath).data.userId == request.auth.uid
             && get(lockPath).data.sessionId == sessionId
             && get(lockPath).data.itineraryId == itineraryId
             && get(lockPath).data.status == "active"
             && !existsAfter(lockPath)
             && existsAfter(itineraryPath(itineraryId))
             && getAfter(itineraryPath(itineraryId)).data.userId == request.auth.uid
             && getAfter(itineraryPath(itineraryId)).data.module2Complete == true
             && getAfter(itineraryPath(itineraryId)).data.status == "Completed"
             && getAfter(itineraryPath(itineraryId)).data.isCompleted == true
             && existsAfter(reportPath)
             && getAfter(reportPath).data.source == "module2_finish_trip"
             && getAfter(reportPath).data.sessionId == sessionId
             && getAfter(reportPath).data.userId == request.auth.uid
             && getAfter(reportPath).data.visibility == "private"
             && getAfter(reportPath).data.publishedAt == null;
    }

    function validCancelledLinkedSession(lockData) {
      let sessionPath = tripSessionPath(lockData.sessionId);

      return existsAfter(sessionPath)
             && getAfter(sessionPath).data.userId == request.auth.uid
             && getAfter(sessionPath).data.userId == lockData.userId
             && getAfter(sessionPath).data.itineraryId == lockData.itineraryId
             && getAfter(sessionPath).data.status == "cancelled"
             && getAfter(sessionPath).data.completedAt == null
             && getAfter(sessionPath).data.cancellationReason == "user_cancelled"
             && getAfter(sessionPath).data.cancelledAt is timestamp;
    }

    function validFinishLinkedSession(lockData) {
      let sessionPath = tripSessionPath(lockData.sessionId);
      let reportPath = ecoReportPath(request.auth.uid, lockData.itineraryId);

      return existsAfter(sessionPath)
             && getAfter(sessionPath).data.userId == request.auth.uid
             && getAfter(sessionPath).data.userId == lockData.userId
             && getAfter(sessionPath).data.itineraryId == lockData.itineraryId
             && getAfter(sessionPath).data.status == "completed"
             && getAfter(sessionPath).data.completedAt is timestamp
             && existsAfter(itineraryPath(lockData.itineraryId))
             && getAfter(itineraryPath(lockData.itineraryId)).data.module2Complete == true
             && existsAfter(reportPath)
             && getAfter(reportPath).data.source == "module2_finish_trip"
             && getAfter(reportPath).data.sessionId == lockData.sessionId
             && getAfter(reportPath).data.visibility == "private";
    }

    match /tripSessions/{sessionId} {

      allow get: if isSignedIn()
                 && resource.data.userId == request.auth.uid;

      allow list: if false;

      allow create: if validTripSessionCreate(sessionId);

      allow update: if validTripSessionCancel()
                    || validTripSessionProgress(sessionId)
                    || validTripSessionComplete(sessionId);

      allow delete: if false;

      match /completedSegments/{segmentId} {

        allow get: if ownedTripSession(sessionId)
                   && resource.data.userId == request.auth.uid
                   && resource.data.sessionId == sessionId;

        allow list: if ownedTripSession(sessionId)
                    && resource.data.userId == request.auth.uid
                    && resource.data.sessionId == sessionId;

        allow create: if validCompletedSegmentCreate(sessionId, segmentId);

        allow update: if false;

        allow delete: if false;
      }
    }


    // =========================================================
    // ACTIVE TRIP LOCKS  (Module 2)
    // =========================================================
    //
    // One document per user: activeTripLocks/{uid}.
    // The document ID must equal the signed-in uid.
    // Get is allowed for a missing own lock (no resource.data check).
    //
    match /activeTripLocks/{lockUserId} {

      allow get: if isSignedIn()
                 && request.auth.uid == lockUserId;

      allow list: if false;

      allow create: if validActiveLockCreate(lockUserId);

      allow update: if false;

      allow delete: if isSignedIn()
                    && request.auth.uid == lockUserId
                    && resource.data.userId == request.auth.uid
                    && (
                      validCancelledLinkedSession(resource.data) ||
                      validFinishLinkedSession(resource.data)
                    );
    }
  }
}
